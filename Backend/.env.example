# ---------------------------------------------------------------------------
# Linkora backend configuration
#
# Copy this file to `.env` and fill in the real values. Never commit `.env`.
# Every secret belongs here (backend only) - never in the frontend, never in
# a browser bundle, and never in a variable prefixed with `VITE_`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# --- Database --------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/linkora

# --- Authentication --------------------------------------------------------
# Used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# How long a session lasts, in days. The signed token and the session cookie
# both expire after this, and an active session is renewed on each request
# once it is past the halfway mark, so someone who keeps using Linkora is
# never asked to log in again.
SESSION_TTL_DAYS=7

# The session cookie's attributes. Leave these unset and Linkora works them
# out from the request: `Secure` is set when the request arrives over HTTPS,
# and `SameSite` becomes `None` only when the frontend and the API are on
# different sites. Set them only if a deployment needs something the
# automatic choice cannot work out.
#
#   SESSION_COOKIE_SECURE=true|false     force the Secure attribute on or off
#   SESSION_COOKIE_SAMESITE=strict|lax|none
#
# Note: `SameSite=None` is only accepted by browsers on a `Secure` cookie, so
# it requires HTTPS.
# SESSION_COOKIE_SECURE=
# SESSION_COOKIE_SAMESITE=

# --- Frontend / backend public URLs ---------------------------------------
# The origin the browser app runs on. This is the only CORS origin allowed
# to send credentialed requests.
FRONTEND_ORIGIN=http://localhost:5173
# Where the frontend is reachable by a browser (used to build public URLs).
FRONTEND_PUBLIC_URL=http://localhost:5173
# Where this backend is reachable. Used to build absolute URLs for uploaded
# assets, so the browser can load them directly.
BACKEND_PUBLIC_URL=http://localhost:5000

# --- Upload limits ---------------------------------------------------------
# Maximum size of a single uploaded image, in bytes (5 MB).
MAX_UPLOAD_BYTES=5242880
